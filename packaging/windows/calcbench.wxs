<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="CalcBench"
      Manufacturer="v0l"
      Version="$(var.Version)"
      UpgradeCode="d4a7f1e0-5b39-4c62-a8d1-37e9c0b6f258"
      Scope="perMachine"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of CalcBench is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="packaging\windows\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/v0l/calcbench" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CalcBench">
        <Component Id="AppExe" Guid="a1c4e6b2-3f5d-4c7a-9e18-5b2d7f90c314">
          <File Id="ThermviewExe" Source="$(var.BinDir)\calcbench.exe" KeyPath="yes" />
        </Component>
        <Component Id="AppDocs" Guid="b7d2f3a9-1e48-4a6c-8c05-6e3a9d41b725">
          <File Id="ReadmeMd" Source="README.md" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="AppShortcut" Guid="c93e5d17-72a0-4f8b-b6d4-0f1a8c52e936">
        <Shortcut Id="ThermviewShortcut" Icon="AppIcon" Name="CalcBench" Target="[#ThermviewExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\v0l\Thermview" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="CalcBench" Level="1">
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="AppDocs" />
      <ComponentRef Id="AppShortcut" />
    </Feature>
  </Package>
</Wix>
